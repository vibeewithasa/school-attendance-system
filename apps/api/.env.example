# Copiar a .env (ignorado por Git). Nunca versionar credenciales reales.
# Este archivo es del ROL DE EJECUCION de la API (eta15_api, minimo privilegio). Las credenciales del
# propietario/migrador (eta15_app) van en .env.migrator (ver .env.migrator.example).
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
CORS_ORIGIN=http://127.0.0.1:5173

# PostgreSQL local. La contrasena solo vive en tu .env local (use tools\set-db-password.ps1).
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=eta15_dev
DB_USER=eta15_api
DB_PASSWORD=
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT_MS=3000
DB_STATEMENT_TIMEOUT_MS=10000
READY_TIMEOUT_MS=2000
