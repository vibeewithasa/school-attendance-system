# Copiar a .env (ignorado por Git). Nunca versionar credenciales reales.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
CORS_ORIGIN=http://127.0.0.1:5173

# PostgreSQL local (rol eta15_app). La contrasena solo vive en tu .env local.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=eta15_dev
DB_USER=eta15_app
DB_PASSWORD=
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT_MS=3000
DB_STATEMENT_TIMEOUT_MS=10000
READY_TIMEOUT_MS=2000
