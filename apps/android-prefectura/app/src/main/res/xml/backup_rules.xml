<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 o anterior: ningun dato de la app participa en copias de seguridad completas. -->
<full-backup-content>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
</full-backup-content>
